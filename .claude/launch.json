{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": ".venv/Scripts/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "cea.api:app",
        "--app-dir",
        "src",
        "--port",
        "8001"
      ],
      "port": 8001
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 5173,
      "env": {
        "CEA_API_URL": "http://127.0.0.1:8001"
      }
    }
  ]
}